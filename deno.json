{
  "nodeModulesDir": "auto",
  "imports": {
    "@hono/hono": "jsr:@hono/hono@^4.13.21",
    "@hono/hono/": "jsr:/@hono/hono@^4.13.21/",
    "drizzle-orm": "npm:drizzle-orm@^0.45.4",
    "drizzle-orm/": "npm:/drizzle-orm@^0.45.4/",
    "@electric-sql/pglite": "npm:@electric-sql/pglite@^0.5.17",
    "drizzle-kit": "npm:drizzle-kit@^0.31.11",
    "@std/assert": "jsr:@std/assert@^1.0.0"
  },
  "tasks": {
    "dev": "deno run --watch -A main.ts",
    "start": "deno run -A main.ts",
    "check": "deno check main.ts drizzle.config.ts",
    "db:push": "deno run -A npm:drizzle-kit@0.31.11 push",
    "db:generate": "deno run -A npm:drizzle-kit@0.31.11 generate",
    "db:studio": "deno run -A npm:drizzle-kit@0.31.11 studio",
    "db:push:test": "PGDATA_DIR=./data/test-pgdata deno run -A npm:drizzle-kit@0.31.11 push",
    "test": "deno task db:push:test && PGDATA_DIR=./data/test-pgdata deno test -A"
  },
  "fmt": {
    "lineWidth": 100
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
